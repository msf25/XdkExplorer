<UserControl x:Class="XdkExplorer.Views.TransferJobItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:design="clr-namespace:XdkExplorer.Design"
             mc:Ignorable="d"
             d:DataContext="{x:Static design:DesignData.RunningUpload}"
             d:DesignWidth="960"
             d:Background="{StaticResource CardBackgroundBrush}"
             Foreground="{StaticResource TextPrimaryBrush}">

    <UserControl.Resources>
        <!-- Look per job state -->
        <Style x:Key="IconCircleStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ErrorSubtleBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SuccessSubtleBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Cancelled">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="JobIconStyle" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Text" Value="&#xE74A;"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUpload}" Value="False">
                    <Setter Property="Text" Value="&#xE74B;"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Text" Value="&#xE7BA;"/>
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Text" Value="&#xE73E;"/>
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Cancelled">
                    <Setter Property="Text" Value="&#xE711;"/>
                    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="JobBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource ThinProgressBar}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource SubtleFillBrush}" BorderThickness="0,0,0,1" Padding="0,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <Border Width="32" Height="32" CornerRadius="16" Style="{StaticResource IconCircleStyle}">
                <TextBlock Style="{StaticResource JobIconStyle}"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="  "/>
                    <Run Text="{Binding RouteText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"/>
                </TextBlock>

                <ProgressBar Style="{StaticResource JobBarStyle}" Margin="0,5,0,0" Value="{Binding Progress, Mode=OneWay}"
                             Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0"
                            Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource CaptionText}" Margin="0,0,10,0"
                               Visibility="{Binding CountText, Converter={StaticResource NotEmptyToVis}}"/>
                    
                    <TextBlock Text="{Binding CurrentFileName}" FontSize="12" MaxWidth="260"
                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    
                    <ProgressBar Style="{StaticResource ThinProgressBar}" Width="80" Height="2" Margin="10,0,0,0"
                                 VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                                 Value="{Binding CurrentFileProgress, Mode=OneWay}"/>

                    <TextBlock Text="{Binding CurrentFileProgressText}" FontSize="12" MaxWidth="260" Margin="8,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>

                </StackPanel>

                <TextBlock Text="{Binding DetailText}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" Style="{StaticResource DetailStyle}"
                           Visibility="{Binding DetailText, Converter={StaticResource NotEmptyToVis}}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="{Binding BytesText}" FontSize="12" HorizontalAlignment="Right"
                           Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding RateText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource AccentButton}" Height="30" Padding="12,0" Content="Retry" Command="{Binding RetryCommand}"
                        Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource OutlineButton}" Content="Skip" Margin="6,0,0,0" Command="{Binding SkipCommand}"
                        Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource OutlineButton}" Content="{Binding CancelText}" Margin="6,0,0,0" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Hide" Command="{Binding DismissCommand}"
                        Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="11"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
