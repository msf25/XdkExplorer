<Window x:Class="XdkExplorer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:XdkExplorer.Views"
        xmlns:design="clr-namespace:XdkExplorer.Design"
        mc:Ignorable="d"
        d:DataContext="{x:Static design:DesignData.Main}"
        Title="XDK Explorer" Width="1280" Height="800" MinWidth="960" MinHeight="600"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontSize="14">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding Browser.RefreshCommand}"/>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding Browser.BackCommand}"/>
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding Browser.ForwardCommand}"/>
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding Browser.UpCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <views:ConsoleListView DataContext="{Binding Consoles}"/>

        <Border Grid.Column="1" Background="{StaticResource ContentBackgroundBrush}" CornerRadius="8,0,0,0"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1,1,0,0">
            <Grid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <views:NavigationBar DataContext="{Binding Browser}"/>
                    <Border Grid.Row="1" Height="44" Visibility="{Binding Browser.ShowFileTools, Converter={StaticResource BoolToVis}}">
                        <views:FileToolbar DataContext="{Binding Browser.Actions}"/>
                    </Border>
                    <views:InfoBar Grid.Row="2" DataContext="{Binding InfoBar}"/>
                    <views:FileListView Grid.Row="3" DataContext="{Binding Browser}"
                                        BottomInset="{Binding ActualHeight, ElementName=Transfers}"/>
                    <views:ConsoleOverviewView Grid.Row="3" DataContext="{Binding Overview}"
                                               BottomInset="{Binding ActualHeight, ElementName=Transfers}"/>

                </Grid>

                <views:TransferPanel x:Name="Transfers" DataContext="{Binding Transfers}"
                             VerticalAlignment="Bottom"
                             HorizontalAlignment="Stretch"
                             Panel.ZIndex="1"/>
            </Grid>

        </Border>

        <views:StatusBar Grid.Row="1" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
