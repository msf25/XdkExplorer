<UserControl x:Class="XdkExplorer.Views.ConsoleListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:XdkExplorer.ViewModels"
             xmlns:attached="clr-namespace:XdkExplorer.AttachedProperties"
             xmlns:design="clr-namespace:XdkExplorer.Design"
             mc:Ignorable="d"
             d:DataContext="{x:Static design:DesignData.Consoles}"
             d:DesignWidth="280" d:DesignHeight="720"
             d:Background="{StaticResource WindowBackgroundBrush}"
             Foreground="{StaticResource TextPrimaryBrush}">

    <DockPanel Margin="8,4,8,8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,6,12,10">
            <TextBlock Text="Consoles" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding CountText}" Style="{StaticResource CaptionText}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="4,0">
            <Button Style="{StaticResource AccentButton}" Command="{Binding AddConsoleCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="Add Xbox"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource SubtleButton}" Height="Auto" Padding="8,7" Margin="0,8,0,0"
                    HorizontalContentAlignment="Left" Command="{Binding ScanCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" Width="20" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Scan network"/>
                        <TextBlock Text="Experimental" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,4"/>

            <Button Style="{StaticResource SubtleButton}" Height="Auto" Padding="8" HorizontalContentAlignment="Left"
                    Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" Style="{StaticResource IconText}" Width="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Settings"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Consoles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ConsoleViewModel}">
                        <StackPanel Margin="0,0,0,2">
                            <Button Style="{StaticResource NavItemButton}" Padding="12,8"
                                    attached:Nav.IsSelected="{Binding IsSelected}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Command="{Binding DataContext.SelectConsoleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Set as default"
                                                  Command="{Binding PlacementTarget.Tag.SetDefaultCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"
                                                  Visibility="{Binding IsDefault, Converter={StaticResource InverseBoolToVis}}"/>
                                        <MenuItem Header="Remove as default"
                                                  Command="{Binding PlacementTarget.Tag.RemoveDefaultCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"
                                                  Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                                        <MenuItem Header="Refresh"
                                                  Command="{Binding PlacementTarget.Tag.RefreshCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Reboot"
                                                  Command="{Binding PlacementTarget.Tag.RebootCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="Remove"
                                                  Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Own button, so expanding does not select the console -->
                                    <Button Style="{StaticResource IconButton}" Width="20" Height="20" Margin="-4,0,0,0"
                                            ToolTip="Show or hide drives"
                                            Command="{Binding DataContext.ToggleExpandedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock x:Name="Chevron" Text="&#xE76C;" Style="{StaticResource IconText}" FontSize="10"
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </Button>

                                    <Grid Grid.Column="1" Margin="10,0,0,0" Width="20" Height="20">
                                        <Grid x:Name="ConsoleIcon" Width="17" Height="10" TextElement.Foreground="{StaticResource TextPrimaryBrush}">
                                            <Rectangle RadiusX="2" RadiusY="2" StrokeThickness="1.2"
                                                       Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Grid}}"/>
                                            <Ellipse Width="3.5" Height="3.5"
                                                     Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Grid}}"/>
                                        </Grid>
                                        <Ellipse x:Name="StatusDot" Width="8" Height="8" HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom" Margin="0,0,-3,0"
                                                 Fill="{StaticResource TextTertiaryBrush}"
                                                 Stroke="{StaticResource ContentBackgroundBrush}" StrokeThickness="1.5"/>
                                    </Grid>

                                    <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                        <TextBlock x:Name="NameText" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="&#xE735;" Style="{StaticResource IconText}" FontSize="14"
                                               Foreground="{StaticResource AccentBrush}" ToolTip="Default console"
                                               Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Button>

                            <ItemsControl ItemsSource="{Binding Drives}" Margin="34,2,0,6"
                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DriveViewModel}">
                                        <Button Style="{StaticResource NavItemButton}" Padding="12,6,12,7" Margin="0,0,0,1"
                                                attached:Nav.IsSelected="{Binding IsSelected}"
                                                ToolTip="{Binding ToolTipText}"
                                                ToolTipService.Placement="Right"
                                                ToolTipService.HorizontalOffset="8"
                                                Command="{Binding DataContext.SelectDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Name}" Margin="6,0,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,4,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding FreeText}" Style="{StaticResource CaptionText}"
                                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    <ProgressBar x:Name="UsageBar" Style="{StaticResource ThinProgressBar}"
                                                                 Value="{Binding UsedFraction, Mode=OneWay}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsAlmostFull}" Value="True">
                                                <Setter TargetName="UsageBar" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Online">
                                <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Checking">
                                <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource WarningBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Offline">
                                <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource TextOfflineBrush}"/>
                                <Setter TargetName="ConsoleIcon" Property="TextElement.Foreground" Value="{StaticResource TextOfflineBrush}"/>
                                <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource TextDisabledBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
