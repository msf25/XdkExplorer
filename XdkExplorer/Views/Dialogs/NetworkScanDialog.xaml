<Window x:Class="XdkExplorer.Views.NetworkScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:XdkExplorer.ViewModels"
        xmlns:design="clr-namespace:XdkExplorer.Design"
        mc:Ignorable="d"
        d:DataContext="{x:Static design:DesignData.NetworkScan}"
        Title="Scan network" Width="500" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ContentBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <StackPanel Margin="24,20,24,20">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Scan network" FontWeight="SemiBold"/>
            <Border Margin="10,0,0,0" Padding="6,1" CornerRadius="3" Background="{StaticResource HoverBrush}" VerticalAlignment="Center">
                <TextBlock Text="Experimental" Style="{StaticResource CaptionText}"/>
            </Border>
        </StackPanel>
        <TextBlock Text="Searches the local network by broadcast. Not every console answers to it." Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap" Margin="0,6,0,16"/>

        <!-- Searching -->
        <StackPanel Orientation="Horizontal" Margin="0,8,0,8" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
            <ProgressBar IsIndeterminate="True" Width="60" VerticalAlignment="Center"/>
            <TextBlock Text="Searching …" Margin="10,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Results -->
        <Border CornerRadius="6" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ScanResultViewModel}">
                        <Border Padding="14,10" BorderBrush="{StaticResource SubtleFillBrush}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource OutlineButton}" Content="Add" Command="{Binding AddCommand}"
                                            Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}">
                                        <ProgressBar IsIndeterminate="True" Width="40" VerticalAlignment="Center"/>
                                        <TextBlock Text="Adding …" Style="{StaticResource CaptionText}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Rectangle Width="17" Height="10" RadiusX="2" RadiusY="2" StrokeThickness="1.2"
                                               Stroke="{StaticResource TextSecondaryBrush}"/>
                                    <Ellipse Width="3.5" Height="3.5" Fill="{StaticResource TextSecondaryBrush}"/>
                                </Grid>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Console.Name}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Console.Address}" Style="{StaticResource CaptionText}"/>
                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource CaptionText}" Margin="8,0,0,0"
                                                   Visibility="{Binding StateText, Converter={StaticResource NotEmptyToVis}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Nothing found -->
        <StackPanel Margin="0,12,0,4" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="No consoles found" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Consoles can also be added directly by name or IP address." Margin="0,6,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            <Button Style="{StaticResource OutlineButton}" Height="32" Content="Add by IP" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Click="OnAddByIp"/>
        </StackPanel>

        <DockPanel Margin="0,20,0,0">
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Search again" Style="{StaticResource OutlineButton}" Height="32" Command="{Binding SearchCommand}"/>
                <Button Content="Close" Style="{StaticResource AccentButton}" MinWidth="90" Margin="8,0,0,0" IsCancel="True" IsDefault="True"
                        Click="OnClose"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
