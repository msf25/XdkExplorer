<Window x:Class="XdkExplorer.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:Title="Remove console" Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ContentBackgroundBrush}">

    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="MessageText" d:Text="Remove Devkit-02 from the list?" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="ConfirmButton" d:Content="Remove" Style="{StaticResource AccentButton}" MinWidth="90" Click="OnConfirm"/>
            <Button Content="Cancel" Style="{StaticResource OutlineButton}" MinWidth="90" Height="32"
                    Margin="8,0,0,0" IsCancel="True" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
