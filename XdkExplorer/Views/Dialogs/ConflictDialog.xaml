<Window x:Class="XdkExplorer.Views.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="File already exists"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ContentBackgroundBrush}">

    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="MessageText" d:Text="This file already exists on Devkit-01:" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>

        <TextBlock x:Name="FileText" d:Text="E:/DEVKIT/Ember/default.xbe" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,0"
                   Foreground="{StaticResource TextPrimaryBrush}"/>

        <CheckBox x:Name="ApplyToAllBox" d:Content="Do this for all further conflicts (12 files left)" Margin="0,18,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Replace" Style="{StaticResource AccentButton}" MinWidth="90" Click="OnReplace"/>
            <Button Content="Skip" Style="{StaticResource OutlineButton}" MinWidth="90" Height="32"
                    Margin="8,0,0,0" IsDefault="True" Click="OnSkip"/>
            <Button Content="Cancel transfer" Style="{StaticResource OutlineButton}" Height="32"
                    Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
