<UserControl x:Class="XdkExplorer.Views.FileListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:XdkExplorer.ViewModels"
             xmlns:views="clr-namespace:XdkExplorer.Views"
             xmlns:design="clr-namespace:XdkExplorer.Design"
             mc:Ignorable="d"
             d:DataContext="{x:Static design:DesignData.Browser}"
             d:DesignWidth="990" d:DesignHeight="420"
             d:Background="{StaticResource ContentBackgroundBrush}"
             Foreground="{StaticResource TextPrimaryBrush}">

    <!-- Transparent background so drops also work on an empty folder -->
    <Grid Background="Transparent" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Column headers -->
        <Grid Margin="16,4,22,0" Visibility="{Binding ShowHeader, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Style="{StaticResource ColumnHeaderButton}" Command="{Binding SortCommand}"
                    CommandParameter="{x:Static vm:SortColumn.Name}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Name"/>
                    <TextBlock Text="{Binding NameSortGlyph}" Style="{StaticResource IconText}" FontSize="9" Margin="6,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource ColumnHeaderButton}" Command="{Binding SortCommand}"
                    CommandParameter="{x:Static vm:SortColumn.Size}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Size"/>
                    <TextBlock Text="{Binding SizeSortGlyph}" Style="{StaticResource IconText}" FontSize="9" Margin="6,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource ColumnHeaderButton}" Command="{Binding SortCommand}"
                    CommandParameter="{x:Static vm:SortColumn.Modified}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Modified"/>
                    <TextBlock Text="{Binding ModifiedSortGlyph}" Style="{StaticResource IconText}" FontSize="9" Margin="6,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource ColumnHeaderButton}" Command="{Binding SortCommand}"
                    CommandParameter="{x:Static vm:SortColumn.Type}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Type"/>
                    <TextBlock Text="{Binding TypeSortGlyph}" Style="{StaticResource IconText}" FontSize="9" Margin="6,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Listing -->
        <ListBox x:Name="FileList" Grid.Row="1" Margin="6,0,6,4" ItemsSource="{Binding ItemsView}"
                 SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource FileRowStyle}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}"
                 SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnDoubleClick">
            <ListBox.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding Actions.DeleteCommand}"/>
                <KeyBinding Key="F2" Command="{Binding Actions.RenameCommand}"/>
                <KeyBinding Key="Back" Command="{Binding UpCommand}"/>
            </ListBox.InputBindings>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Launch on Xbox" Command="{Binding Actions.LaunchCommand}"/>
                    <MenuItem Header="Download to …" Command="{Binding Actions.DownloadCommand}"/>
                    <Separator/>
                    <MenuItem Header="Rename" InputGestureText="F2" Command="{Binding Actions.RenameCommand}"/>
                    <MenuItem Header="Delete" InputGestureText="Del" Command="{Binding Actions.DeleteCommand}"/>
                    <Separator/>
                    <MenuItem Header="New folder" Command="{Binding Actions.NewFolderCommand}"/>
                    <MenuItem Header="Refresh" InputGestureText="F5" Command="{Binding RefreshCommand}"/>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="Icon" Text="&#xE8A5;" Style="{StaticResource IconText}"
                                   HorizontalAlignment="Left" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Border x:Name="XbeIcon" Width="16" Height="16" CornerRadius="8" HorizontalAlignment="Left"
                                Background="{StaticResource AccentBrush}" Visibility="Collapsed">
                            <Path Data="M4.5,4.5 L11.5,11.5 M11.5,4.5 L4.5,11.5" Stroke="{StaticResource OnAccentBrush}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>

                        <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="13" Padding="11,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" FontSize="13" Padding="11,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="4" Text="{Binding TypeText}" FontSize="13" Padding="11,0,0,0"
                                   Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                            <Setter TargetName="Icon" Property="Text" Value="&#xE8D5;"/>
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource FolderBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsXbe}" Value="True">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="XbeIcon" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
                            <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Loading -->
        <StackPanel Grid.Row="1" Margin="16,4,16,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Height="36">
                <ProgressBar IsIndeterminate="True" Width="60" VerticalAlignment="Center"/>
                <TextBlock Text="Loading …" Margin="12,0,0,0" FontSize="13" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{x:Static views:SkeletonRows.Widths}" Opacity="0.9">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="18" Height="16" CornerRadius="3" HorizontalAlignment="Left" Background="#12FFFFFF"/>
                            <Border Grid.Column="1" Width="{Binding}" Height="10" CornerRadius="5" HorizontalAlignment="Left"
                                    Background="#12FFFFFF"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Empty folder or error -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Offline -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
                    Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}">
            <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource SubtleFillBrush}">
                <TextBlock Text="&#xEB55;" Style="{StaticResource IconText}" FontSize="22" Foreground="{StaticResource TextTertiaryBrush}"/>
            </Border>
            <TextBlock Text="Console not reachable" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Check that the console is switched on and in the same network. For xemu, port 731 has to be forwarded."/>
            <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                    Command="{Binding RetryConnectionCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="Try again"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Connecting -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}">
            <ProgressBar IsIndeterminate="True" Width="160"/>
            <TextBlock Text="Connecting …" Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- No console -->
        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecondaryBrush}" Text="No console yet. Add one in the sidebar."
                   Visibility="{Binding HasNoConsole, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
