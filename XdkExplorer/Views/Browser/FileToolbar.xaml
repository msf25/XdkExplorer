<UserControl x:Class="XdkExplorer.Views.FileToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:design="clr-namespace:XdkExplorer.Design"
             mc:Ignorable="d"
             d:DataContext="{x:Static design:DesignData.Actions}"
             d:DesignWidth="990" d:DesignHeight="44"
             d:Background="{StaticResource ContentBackgroundBrush}"
             Foreground="{StaticResource TextPrimaryBrush}">

    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1">
        <DockPanel Margin="12,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding LaunchCommand}"
                    ToolTip="Reboots the console into the selected .xbe" ToolTipService.ShowOnDisabled="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="Launch on Xbox"/>
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SubtleButton}" Command="{Binding NewFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F4;" Style="{StaticResource IconText}" Margin="0,0,8,0"/>
                        <TextBlock Text="New folder"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" Command="{Binding UploadCommand}" Margin="2,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" Style="{StaticResource IconText}" Margin="0,0,8,0"/>
                        <TextBlock Text="Upload"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" Command="{Binding DownloadCommand}" Margin="2,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" Margin="0,0,8,0"/>
                        <TextBlock Text="Download to …"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Height="20" Background="{StaticResource StrokeStrongBrush}" Margin="6,0"/>

                <Button Style="{StaticResource SubtleButton}" Command="{Binding RenameCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8AC;" Style="{StaticResource IconText}" Margin="0,0,8,0"/>
                        <TextBlock Text="Rename"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" Command="{Binding DeleteCommand}" Margin="2,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" Margin="0,0,8,0"/>
                        <TextBlock Text="Delete"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
