<UserControl x:Class="XdkExplorer.Design.StylePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:attached="clr-namespace:XdkExplorer.AttachedProperties"
             mc:Ignorable="d"
             d:DesignWidth="900"
             Background="{StaticResource ContentBackgroundBrush}"
             Foreground="{StaticResource TextPrimaryBrush}"
             FontSize="14" Height="1250">

    <!-- Every style in Themes/Controls.xaml in its relevant states. App.OnStartup opens this as a window for the styles argument. -->

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,24,0,10"/>
        </Style>

        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SwatchLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="6,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,0,24,24">

            <!-- Buttons -->
            <TextBlock Text="Buttons" Style="{StaticResource SectionTitle}"/>
            <WrapPanel>
                <Button Style="{StaticResource SubtleButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" Style="{StaticResource IconText}" Margin="0,0,8,0"/>
                        <TextBlock Text="SubtleButton"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" Content="Subtle disabled" IsEnabled="False" Margin="0,0,8,0"/>
                <Button Style="{StaticResource IconButton}" Margin="0,0,8,0">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource IconButton}" IsEnabled="False" Margin="0,0,8,0">
                    <TextBlock Text="&#xE72B;" Style="{StaticResource IconText}" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource OutlineButton}" Content="OutlineButton" Margin="0,0,8,0"/>
                <Button Style="{StaticResource AccentButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0"/>
                        <TextBlock Text="AccentButton" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButton}" Content="Accent disabled" IsEnabled="False"/>
            </WrapPanel>

            <!-- Sidebar entries -->
            <TextBlock Text="NavItemButton" Style="{StaticResource SectionTitle}"/>
            <StackPanel Width="264" HorizontalAlignment="Left">
                <Button Style="{StaticResource NavItemButton}" Padding="12,8" Margin="0,0,0,2">
                    <StackPanel>
                        <TextBlock Text="Normal"/>
                        <TextBlock Text="192.168.1.21 · Online" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource NavItemButton}" Padding="12,8" attached:Nav.IsSelected="True">
                    <StackPanel>
                        <TextBlock Text="Selected"/>
                        <TextBlock Text="192.168.1.20 · Default" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- File rows -->
            <TextBlock Text="FileRowStyle" Style="{StaticResource SectionTitle}"/>
            <ListBox Width="520" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource FileRowStyle}" SelectedIndex="1">
                <ListBoxItem Content="Normal row"/>
                <ListBoxItem Content="Selected row"/>
                <ListBoxItem Content="Another row"/>
            </ListBox>

            <!-- Overview -->
            <TextBlock Text="Card, TileButton, LinkButton, SkeletonBar" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}" Width="520" HorizontalAlignment="Left" Margin="0">
                <StackPanel>
                    <TextBlock Text="Card" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource CardDivider}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource TileButton}" Width="160">
                            <StackPanel>
                                <TextBlock Text="E:" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Game Development Volume" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <Button Style="{StaticResource LinkButton}" Content="LinkButton" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource SkeletonBar}" Width="140" Margin="0,12,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Progress -->
            <TextBlock Text="ThinProgressBar" Style="{StaticResource SectionTitle}"/>
            <StackPanel Width="320" HorizontalAlignment="Left">
                <ProgressBar Style="{StaticResource ThinProgressBar}" Value="0" Margin="0,0,0,12"/>
                <ProgressBar Style="{StaticResource ThinProgressBar}" Value="0.4" Margin="0,0,0,12"/>
                <ProgressBar Style="{StaticResource ThinProgressBar}" Value="1" Margin="0,0,0,12"/>
                <ProgressBar Style="{StaticResource ThinProgressBar}" Value="0.93" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,12"/>
                <ProgressBar Style="{StaticResource ThinProgressBar}" Value="0.38" Foreground="{StaticResource ErrorBrush}"/>
            </StackPanel>

            <!-- Text -->
            <TextBlock Text="Text" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Primary text"/>
            <TextBlock Text="Secondary text" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Text="CaptionText" Style="{StaticResource CaptionText}"/>
            <TextBlock Text="Disabled text" Foreground="{StaticResource TextDisabledBrush}"/>
            <TextBlock Text="default.xbe" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold"/>
            <TextBlock Text="Error text" Foreground="{StaticResource ErrorBrush}"/>

            <!-- Palette -->
            <TextBlock Text="Palette" Style="{StaticResource SectionTitle}"/>
            <WrapPanel>
                <Border Style="{StaticResource Swatch}" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="Accent" Style="{StaticResource SwatchLabel}" Foreground="{StaticResource OnAccentBrush}"/>
                </Border>
                <Border Style="{StaticResource Swatch}" Background="{StaticResource AccentHoverBrush}">
                    <TextBlock Text="AccentHover" Style="{StaticResource SwatchLabel}" Foreground="{StaticResource OnAccentBrush}"/>
                </Border>
                <Border Style="{StaticResource Swatch}" Background="{StaticResource AccentSubtleBrush}">
                    <TextBlock Text="AccentSubtle" Style="{StaticResource SwatchLabel}"/>
                </Border>
                <Border Style="{StaticResource Swatch}" Background="{StaticResource WarningBrush}">
                    <TextBlock Text="Warning" Style="{StaticResource SwatchLabel}" Foreground="Black"/>
                </Border>
                <Border Style="{StaticResource Swatch}" Background="{StaticResource WarningSubtleBrush}">
                    <TextBlock Text="WarningSubtle" Style="{StaticResource SwatchLabel}"/>
                </Border>
                <Border Style="{StaticResource Swatch}" Background="{StaticResource ErrorBrush}">
                    <TextBlock Text="Error" Style="{StaticResource SwatchLabel}" Foreground="Black"/>
                </Border>
                <Border Style="{StaticResource Swatch}" Background="{StaticResource ErrorSubtleBrush}">
                    <TextBlock Text="ErrorSubtle" Style="{StaticResource SwatchLabel}"/>
                </Border>
                <Border Style="{StaticResource Swatch}" Background="{StaticResource SuccessBrush}">
                    <TextBlock Text="Success" Style="{StaticResource SwatchLabel}" Foreground="Black"/>
                </Border>
                <Border Style="{StaticResource Swatch}" Background="{StaticResource FolderBrush}">
                    <TextBlock Text="Folder" Style="{StaticResource SwatchLabel}" Foreground="Black"/>
                </Border>
                <Border Style="{StaticResource Swatch}" Background="{StaticResource WindowBackgroundBrush}">
                    <TextBlock Text="WindowBackground" Style="{StaticResource SwatchLabel}"/>
                </Border>
                <Border Style="{StaticResource Swatch}" Background="{StaticResource ContentBackgroundBrush}">
                    <TextBlock Text="ContentBackground" Style="{StaticResource SwatchLabel}"/>
                </Border>
                <Border Style="{StaticResource Swatch}" Background="{StaticResource CardBackgroundBrush}">
                    <TextBlock Text="CardBackground" Style="{StaticResource SwatchLabel}"/>
                </Border>
                <Border Style="{StaticResource Swatch}" Background="{StaticResource InfoBarBackgroundBrush}">
                    <TextBlock Text="InfoBarBackground" Style="{StaticResource SwatchLabel}"/>
                </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
