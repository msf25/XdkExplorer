<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palette (dark) -->
    <Color x:Key="AccentColor">#6BC96B</Color>
    <Color x:Key="AccentHoverColor">#7FD67F</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#8BE08B"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0C1A0C"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#296BC96B"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="TextOfflineBrush" Color="#8A8A8A"/>

    <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4"/>
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#442726"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FCE100"/>
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#433519"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#296CCB5F"/>
    <SolidColorBrush x:Key="FolderBrush" Color="#E8C46A"/>

    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#262626"/>
    <SolidColorBrush x:Key="InfoBarBackgroundBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#8BFFFFFF"/>

    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1C241C" Offset="0"/>
        <GradientStop Color="#202020" Offset="0.42"/>
        <GradientStop Color="#1F1F22" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
